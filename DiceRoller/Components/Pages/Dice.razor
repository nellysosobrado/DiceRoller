@page "/dice"
@inject DiceService DiceService
@using DiceRoller.Services

<PageTitle>Dice Mini Game</PageTitle>

<h1> Roll the Dice!</h1>

<p>How many times do you want to roll the dice?</p>

<input type="number" @bind="numberOfRolls" min="1"/>

<button @onclick="RollDice">
    Roll Dice
</button>

@if (diceResults.Count > 0)
{
    <h3> Results</h3>
    @foreach(int result in diceResults)
    {
        <p> You rolled a: @result</p>
    }

    <h3>Statistics</h3>
    <p>Total: @total</p>
    <p>Average: @average.ToString("0.00")</p>
    <p>Highest Roll: @highest</p>
    <p>Lowest´roll : @lowest</p>

}

@code {
    private int numberOfRolls = 1;
    private List<int> diceResults = new List<int>();

    private int total;
    private double average;
    private int highest;
    private int lowest;

    private void RollDice()
    {
        diceResults.Clear();

        for(int i = 0; i<numberOfRolls;i++)
        {
            int diceRoll = DiceService.Roll();

            diceResults.Add(diceRoll);
        }

        total = diceResults.Sum();
        average = diceResults.Average();
        highest = diceResults.Max();
        lowest = diceResults.Min();

    }
}