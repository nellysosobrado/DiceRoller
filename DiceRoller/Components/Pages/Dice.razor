@page "/dice"
@inject DiceService DiceService
@using DiceRoller.Services
@using DiceRoller.Models

<PageTitle>Dice Mini Game</PageTitle>

<h1> Roll the Dice!</h1>

<p>How many times do you want to roll the dice?</p>

<input type="number" @bind="numberOfRolls" min="1"/>

<button @onclick="RollDice">
    Roll Dice
</button>

@if (diceResult !=null)
{
    <h3> Results</h3>
    @foreach(int roll in diceResult.Rolls)
    {
        <p> You rolled a: @roll</p>
    }

    <h3>Statistics</h3>
    <p>Total: @diceResult.Total</p>
    <p>Average: @diceResult.Average.ToString("0.00")</p>
    <p>Highest Roll: @diceResult.Highest</p>
    <p>Lowest Roll: @diceResult.Lowest</p>

}

@code {
    private int numberOfRolls = 1;

    private DiceResult? diceResult;

    private void RollDice()
    {
        if(numberOfRolls < 1)
        {
            return;
        }
        diceResult = DiceService.Roll(numberOfRolls);
    }
}